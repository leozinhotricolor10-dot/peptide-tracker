    "workbox-window": "7.4.1"
  },
  "overrides": {
    "glob": "14.0.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.6",
